{
  "name": "@xmemo/client",
  "version": "0.4.185",
  "description": "Privacy-first CLI client and MCP setup tool for XMemo.",
  "mcpName": "io.github.yonro/xmemo",
  "type": "module",
  "bin": {
    "client": "bin/memory-os.js",
    "xmemo-mcp": "bin/mcp-stdio.js",
    "xmemo": "bin/memory-os.js",
    "memory-os": "bin/memory-os.js"
  },
  "files": [
    "bin",
    "docs/assets",
    "scripts",
    "!scripts/build-skill-npm-package.mjs",
    "src",
    "plugins/xmemo",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "node scripts/check-js.mjs",
    "test": "node scripts/run-tests.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "release:check": "node scripts/check-release-version.mjs",
    "prepublishOnly": "npm run release:check && npm run lint && npm test && npm run pack:dry-run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yonro/memory-os-cli.git"
  },
  "bugs": {
    "url": "https://github.com/yonro/memory-os-cli/issues"
  },
  "homepage": "https://github.com/yonro/memory-os-cli#readme",
  "keywords": [
    "xmemo",
    "memory-os",
    "mcp",
    "agent",
    "cli",
    "privacy"
  ],
  "license": "MIT"
}
